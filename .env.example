# ai-vuln-harness configuration
# Copy to `.env` (same folder) — it is auto-loaded on every run.
# Precedence:  CLI flag  >  .env  >  built-in default
# Real environment variables also win over this file.
# Load a different file with:  python scanner.py ./src --env-file prod.env

# ---- LLM provider ---------------------------------------------------------
# ollama | openai | custom   (openai/custom = any OpenAI-compatible endpoint)
AVH_PROVIDER=ollama
AVH_MODEL=qwen3:30b

# Structured-output mode for openai/custom providers:
#   schema       (default) json_schema strict — best for local models (vLLM…)
#   json_object  for Anthropic/Claude proxies that reject json_schema (403/hang)
#   off          no hint; rely on prompt + parser (most compatible)
# AVH_STRUCTURED=schema

# Endpoint. Leave blank to use the provider default:
#   ollama          -> http://localhost:11434
#   openai/custom   -> <base>/v1  (e.g. http://localhost:1234/v1)
AVH_BASE_URL=

# Bearer token for openai-compatible providers (LM Studio/vLLM/gateway).
# LLM_API_KEY takes priority over AVH_API_KEY.
LLM_API_KEY=
# AVH_API_KEY=

# Custom auth headers for gateways that DON'T use "Authorization: Bearer".
# JSON object; these override the default Authorization header.
# Fixes many HTTP 403 errors from corporate/internal gateways.
# AVH_HEADERS={"api-key": "YOUR_KEY"}
# AVH_HEADERS={"X-API-Key": "YOUR_KEY", "X-Team": "security"}

# ---- Model options --------------------------------------------------------
AVH_NUM_CTX=32768
AVH_TEMPERATURE=0.1
AVH_TIMEOUT=600
AVH_RETRIES=2

# ---- Scan scope -----------------------------------------------------------
# AVH_PATH=./src              # default target if none passed on the CLI
# AVH_OUT=findings.ndjson
# AVH_EXT=php,py,js           # restrict file types ('*' = all text files)
# AVH_INCLUDE=src/**
# AVH_EXCLUDE=tests/**,**/migrations/**
AVH_WORKERS=1
# AVH_CHUNK_LINES=700
# AVH_CHUNK_OVERLAP=40
# AVH_MAX_FILE_BYTES=400000
# AVH_MIN_CONFIDENCE=Low      # High | Medium | Low

# ---- Import context -------------------------------------------------------
# AVH_NO_IMPORTS=false
# AVH_CONTEXT_BUDGET=6000
# AVH_MAX_LOCAL_IMPORTS=10

# ---- Second (verify) pass -------------------------------------------------
AVH_VERIFY=true
# AVH_KEEP_FP=false

# ---- Analysis mode --------------------------------------------------------
# file  = per-file review (default)
# chain = whole-program gadget/deserialization chain analysis
# AVH_MODE=file
# AVH_CHAIN_BUDGET=60000      # chars of gadget context per sink (chain mode)
# AVH_MAX_CHAINS=20           # max deserialization sinks analyzed (chain mode)

# ---- Skills / knowledge packs injected into the review --------------------
# Comma-separated SKILL.md / .md files or dirs of vuln checklists & patterns.
# AVH_SKILLS=./skillpacks,./my-owasp-skill/SKILL.md
# AVH_SKILL_BUDGET=80000      # chars of skill guidance per file (also caps each
#                             # skill). 80k~=20k tokens; fine for sonnet/qwen3
#                             # big context. Lower for small local ctx models.

# ---- Dependency CVE lookup (multiple sources, results are merged+deduped) --
# AVH_OSV_DB=./osv-db         # local offline OSV JSON dir (see fetch_osv.py)
# AVH_OSV_ONLINE=false        # live api.osv.dev
# AVH_GHSA=false              # GitHub Advisory (real-time) — needs GITHUB_TOKEN
# GITHUB_TOKEN=
# AVH_NVD=false               # NVD/NIST 2.0 — optional NVD_API_KEY (higher rate)
# NVD_API_KEY=
# AVH_NATIVE_AUDIT=false      # run composer/npm/pip-audit/cargo audit & ingest

# ---- Cost estimate --------------------------------------------------------
# USD per 1M tokens for the summary cost estimate. Unset = auto by model name
# (see PRICE_TABLE in scanner.py); 0 = local/free. Set to your real rates.
# AVH_PRICE_IN=3.0
# AVH_PRICE_OUT=15.0

# ---- Misc -----------------------------------------------------------------
# AVH_VERBOSE=true
